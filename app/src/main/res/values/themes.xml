<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ComputerShop" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->

        <!-- Màu sắc chủ đạo (Trỏ vào tên màu mới trong colors.xml) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Màu nền mặc định cho toàn app -->
        <item name="android:windowBackground">@color/app_background</item>

        <!-- Màu chữ mặc định -->
        <item name="android:textColorPrimary">@color/text_title</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Bỏ title bar mặc định (vì mình tự làm custom header) -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ComputerShop" parent="Base.Theme.ComputerShop" />
</resources>